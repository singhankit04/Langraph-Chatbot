# ==============================================================================
# EideticAI Backend - Environment Variables Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Primary & Fallback LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Tavily Web Search API
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Qdrant Vector Cloud Database
QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=rag_documents

# Redis (BullMQ Message Broker for Background PDF Processing)
REDIS_URL=redis://default:your_redis_password@your_redis_host:port

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_URL=http://localhost:3000,https://eideticai.vercel.app

# Render / Deployment Keep-Alive Self-Ping
BACKEND_URL=https://your-backend-app.onrender.com

